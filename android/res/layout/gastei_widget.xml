<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="16dp"
    android:background="@drawable/gastei_widget_bg">
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView android:id="@+id/w_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Disponível no mês" android:textColor="#F6C15A" android:textSize="12sp" android:textStyle="bold" android:maxLines="1"/>
        <TextView android:id="@+id/w_value" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Abra o Gastei" android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold" android:maxLines="1"
            android:fontFamily="monospace"/>
        <TextView android:id="@+id/w_sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="#D9FFFFFF" android:textSize="12sp" android:maxLines="1"/>
    </LinearLayout>
    <TextView android:id="@+id/w_add" android:layout_width="wrap_content" android:layout_height="44dp"
        android:gravity="center" android:paddingLeft="16dp" android:paddingRight="16dp" android:layout_marginLeft="10dp"
        android:text="+ Gasto" android:textColor="#2B1B00" android:textSize="15sp" android:textStyle="bold"
        android:background="@drawable/gastei_widget_btn"/>
</LinearLayout>
