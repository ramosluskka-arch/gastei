{
  "name": "gastei-pc",
  "productName": "Gastify",
  "version": "1.1.0",
  "description": "Gastify no PC, em formato de celular",
  "main": "main.js",
  "author": "Gastify",
  "license": "UNLICENSED",
  "build": {
    "appId": "com.gastei.pc",
    "productName": "Gastify",
    "files": [
      "main.js",
      "phone.html",
      "app/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png"
    },
    "portable": {
      "artifactName": "Gastify-PC.exe"
    },
    "nsis": {
      "artifactName": "Gastify-Setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Gastify",
      "uninstallDisplayName": "Gastify",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "language": "1046",
      "installerLanguages": [
        "pt_BR"
      ]
    }
  }
}
